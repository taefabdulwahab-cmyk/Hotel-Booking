<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0"
            style="-fx-background-color: #FFFFFF;"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hotel.controller.RoomBookingController">

    <!-- Sidebar -->
    <left>
        <VBox prefWidth="230.0" spacing="12.0"
              style="-fx-background-color: #1F3B57;">

            <padding>
                <Insets top="30.0" right="20.0"
                        bottom="30.0" left="20.0"/>
            </padding>

            <Label text="Hotel Booking"
                   wrapText="true"
                   style="-fx-text-fill: #FFFFFF;
                          -fx-font-family: System;
                          -fx-font-size: 30;
                          -fx-font-weight: bold;"/>

            <Region maxWidth="60.0"
                    minHeight="3.0"
                    prefHeight="3.0"
                    style="-fx-background-color: #D4AF37;"/>

            <Label text="Room Booking"
                   wrapText="true"
                   style="-fx-text-fill: #C7D3E0;
                          -fx-font-family: System;
                          -fx-font-size: 13;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="backButton" text="Back to Dashboard"
                    maxWidth="Infinity"
                    style="-fx-background-color: #FFFFFF;
                           -fx-text-fill: #1F3B57;
                           -fx-font-family: System;
                           -fx-font-size: 15;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-cursor: hand;"/>

        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox spacing="14.0">

            <padding>
                <Insets top="25.0" right="30.0"
                        bottom="25.0" left="30.0"/>
            </padding>

            <!-- Page Title -->
            <Label text="Room Booking"
                   style="-fx-text-fill: #1F3B57;
                          -fx-font-family: System;
                          -fx-font-size: 22;
                          -fx-font-weight: bold;"/>

            <Label text="Create and manage room bookings"
                   style="-fx-text-fill: #5B6474;
                          -fx-font-family: System;
                          -fx-font-size: 13;"/>

            <!-- Guest Information -->
            <Label text="Guest Information"
                   style="-fx-text-fill: #1F3B57;
                          -fx-font-family: System;
                          -fx-font-size: 16;
                          -fx-font-weight: bold;"/>

           <VBox spacing="6.0">

    <Label text="Guest Name"
           style="-fx-text-fill: #374151;
                  -fx-font-family: System;
                  -fx-font-size: 13;
                  -fx-font-weight: bold;"/>

    <TextField fx:id="guestNameField"
               promptText="Enter guest name"
               maxWidth="Infinity"
               style="-fx-font-size: 13;"/>

    <Label text="Phone Number"
           style="-fx-text-fill: #374151;
                  -fx-font-family: System;
                  -fx-font-size: 13;
                  -fx-font-weight: bold;"/>

    <TextField fx:id="phoneField"
               promptText="Enter phone number"
               maxWidth="Infinity"
               style="-fx-font-size: 13;"/>

</VBox>

            <Separator/>

            <!-- Room Selection -->
            <Label text="Room Selection"
                   style="-fx-text-fill: #1F3B57;
                          -fx-font-family: System;
                          -fx-font-size: 16;
                          -fx-font-weight: bold;"/>

            <GridPane hgap="15.0" vgap="6.0">

                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Room"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-text-fill: #374151;
                              -fx-font-family: System;
                              -fx-font-size: 13;
                              -fx-font-weight: bold;"/>

                <Label text="Room Type"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0"
                       style="-fx-text-fill: #374151;
                              -fx-font-family: System;
                              -fx-font-size: 13;
                              -fx-font-weight: bold;"/>

                <Label text="Price per Night (SAR)"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"
                       style="-fx-text-fill: #374151;
                              -fx-font-family: System;
                              -fx-font-size: 13;
                              -fx-font-weight: bold;"/>

                <ComboBox fx:id="roomComboBox"
                          promptText="Select room"
                          maxWidth="Infinity"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="1"
                          style="-fx-font-size: 13;"/>

                <TextField fx:id="roomTypeField"
                           promptText="Room type"
                           editable="false"
                           maxWidth="Infinity"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"
                           style="-fx-font-size: 13;"/>

                <TextField fx:id="priceField"
                           promptText="Price in SAR"
                           editable="false"
                           maxWidth="Infinity"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="1"
                           style="-fx-font-size: 13;"/>

            </GridPane>

            <Separator/>

            <!-- Booking Dates -->
            <Label text="Booking Dates"
                   style="-fx-text-fill: #1F3B57;
                          -fx-font-family: System;
                          -fx-font-size: 16;
                          -fx-font-weight: bold;"/>

            <GridPane hgap="15.0" vgap="6.0">

                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Check-in Date"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-text-fill: #374151;
                              -fx-font-family: System;
                              -fx-font-size: 13;
                              -fx-font-weight: bold;"/>

                <Label text="Check-out Date"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0"
                       style="-fx-text-fill: #374151;
                              -fx-font-family: System;
                              -fx-font-size: 13;
                              -fx-font-weight: bold;"/>

                <DatePicker fx:id="checkInDatePicker"
                            maxWidth="Infinity"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                <DatePicker fx:id="checkOutDatePicker"
                            maxWidth="Infinity"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>

            </GridPane>

            <Separator/>

            <!-- Total Amount -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">

                <Label text="Total Amount:"
                       style="-fx-text-fill: #1F3B57;
                              -fx-font-family: System;
                              -fx-font-size: 16;
                              -fx-font-weight: bold;"/>

                <Label fx:id="totalAmountLabel"
                       text="0.00 SAR"
                       style="-fx-text-fill: #B58B45;
                              -fx-font-family: System;
                              -fx-font-size: 16;
                              -fx-font-weight: bold;"/>

            </HBox>


            <!-- Action Buttons -->
            <HBox alignment="CENTER_RIGHT" spacing="10.0">

                <Button fx:id="calculateButton"
                        prefWidth="110.0"
                        text="Calculate"
                        style="-fx-background-color: #1F3B57;
                               -fx-text-fill: #FFFFFF;
                               -fx-font-family: System;
                               -fx-font-size: 15;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;"/>

                <Button fx:id="confirmBookingButton"
                        prefWidth="150.0"
                        text="Confirm Booking"
                        style="-fx-background-color: #1F3B57;
                               -fx-text-fill: #FFFFFF;
                               -fx-font-family: System;
                               -fx-font-size: 15;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;"/>

                <Button fx:id="clearButton"
                        prefWidth="110.0"
                        text="Clear"
                        style="-fx-background-color: #FFFFFF;
                               -fx-text-fill: #1F3B57;
                               -fx-border-color: #1F3B57;
                               -fx-border-radius: 6;
                               -fx-background-radius: 6;
                               -fx-font-family: System;
                               -fx-font-size: 15;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>
               

            </HBox>

        </VBox>
    </center>

</BorderPane>