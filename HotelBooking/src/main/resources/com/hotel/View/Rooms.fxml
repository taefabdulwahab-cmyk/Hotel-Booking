<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Room Management window. Owner: Maysaa -->
<BorderPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #FFFFFF;"
            xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hotel.controller.RoomsController">

    <!-- ===== Left: navy side panel ===== -->
    <left>
        <VBox prefWidth="230.0" spacing="12.0" style="-fx-background-color: #1F3B57;">
            <padding>
                <Insets top="30.0" right="20.0" bottom="30.0" left="20.0" />
            </padding>
            <Label text="Hotel Booking" wrapText="true"
                   style="-fx-text-fill: #FFFFFF; -fx-font-family: System; -fx-font-size: 30; -fx-font-weight: bold;" />
            <Region maxWidth="60.0" minHeight="3.0" prefHeight="3.0" style="-fx-background-color: #D4AF37;" />
            <Label text="Room Management" wrapText="true"
                   style="-fx-text-fill: #C7D3E0; -fx-font-family: System; -fx-font-size: 13;" />
            <Region VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#handleBack" text="Back to Dashboard"
                    style="-fx-background-color: #FFFFFF; -fx-text-fill: #1F3B57; -fx-font-family: System; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
        </VBox>
    </left>

    <!-- ===== Center: white content area ===== -->
    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets top="25.0" right="30.0" bottom="25.0" left="30.0" />
            </padding>

            <!-- Page title -->
            <Label text="Rooms"
                   style="-fx-text-fill: #1F3B57; -fx-font-family: System; -fx-font-size: 22; -fx-font-weight: bold;" />
            <Label text="Add, edit and track the hotel rooms"
                   style="-fx-text-fill: #5B6474; -fx-font-family: System; -fx-font-size: 13;" />

            <!-- Form -->
            <GridPane hgap="15.0" vgap="6.0">
                <Label text="Room Number" GridPane.columnIndex="0" GridPane.rowIndex="0"
                       style="-fx-text-fill: #374151; -fx-font-family: System; -fx-font-size: 13; -fx-font-weight: bold;" />
                <TextField fx:id="roomNumberField" prefWidth="150.0" promptText="e.g. 101"
                           GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-size: 13;" />

                <Label text="Type" GridPane.columnIndex="1" GridPane.rowIndex="0"
                       style="-fx-text-fill: #374151; -fx-font-family: System; -fx-font-size: 13; -fx-font-weight: bold;" />
                <ComboBox fx:id="typeCombo" prefWidth="150.0" promptText="Select type"
                          GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-size: 13;" />

                <Label text="Price per Night (SAR)" GridPane.columnIndex="2" GridPane.rowIndex="0"
                       style="-fx-text-fill: #374151; -fx-font-family: System; -fx-font-size: 13; -fx-font-weight: bold;" />
                <TextField fx:id="priceField" prefWidth="150.0" promptText="e.g. 350"
                           GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-size: 13;" />

                <CheckBox fx:id="availableCheck" text="Available" GridPane.columnIndex="3" GridPane.rowIndex="1"
                          style="-fx-text-fill: #374151; -fx-font-family: System; -fx-font-size: 13;" />
            </GridPane>

            <!-- Buttons -->
            <HBox spacing="10.0">
                <Button fx:id="addButton" onAction="#handleAdd" prefWidth="110.0" text="Add"
                        style="-fx-background-color: #1F3B57; -fx-text-fill: #FFFFFF; -fx-font-family: System; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
                <Button fx:id="updateButton" onAction="#handleUpdate" prefWidth="110.0" text="Update"
                        style="-fx-background-color: #1F3B57; -fx-text-fill: #FFFFFF; -fx-font-family: System; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
                <Button fx:id="deleteButton" onAction="#handleDelete" prefWidth="110.0" text="Delete"
                        style="-fx-background-color: #1F3B57; -fx-text-fill: #FFFFFF; -fx-font-family: System; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
                <Button onAction="#handleClear" prefWidth="110.0" text="Clear"
                        style="-fx-background-color: #FFFFFF; -fx-text-fill: #1F3B57; -fx-border-color: #1F3B57; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-family: System; -fx-font-size: 15; -fx-font-weight: bold; -fx-cursor: hand;" />
            </HBox>

            <!-- Search, filter, sort -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <TextField fx:id="searchField" promptText="Search by room number or type..." HBox.hgrow="ALWAYS"
                           style="-fx-font-size: 13;" />
                <ComboBox fx:id="filterCombo" prefWidth="160.0" style="-fx-font-size: 13;" />
                <ComboBox fx:id="sortCombo" prefWidth="190.0" style="-fx-font-size: 13;" />
            </HBox>

            <!-- Rooms table (double-click a row to edit it) -->
            <TableView fx:id="roomsTable" VBox.vgrow="ALWAYS" style="-fx-font-size: 13;">
                <columns>
                    <TableColumn fx:id="numberColumn" prefWidth="170.0" text="Room Number" />
                    <TableColumn fx:id="typeColumn" prefWidth="170.0" text="Type" />
                    <TableColumn fx:id="priceColumn" prefWidth="200.0" text="Price per Night (SAR)" />
                    <TableColumn fx:id="statusColumn" prefWidth="170.0" text="Status" />
                </columns>
             
            </TableView>

            <Label fx:id="countLabel" style="-fx-text-fill: #5B6474; -fx-font-family: System; -fx-font-size: 13;" />
        </VBox>
    </center>
</BorderPane>