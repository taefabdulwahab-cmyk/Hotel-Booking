
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane"
            prefHeight="650.0" prefWidth="1000.0"
            style="-fx-background-color: #FFFFFF;"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hotel.controller.ReservationController">

    <children>

        <!-- Reservations Table -->
        <TableView fx:id="reservationTable"
                   layoutX="325.0" layoutY="195.0"
                   prefHeight="220.0" prefWidth="630.0">
            <columns>
                <TableColumn fx:id="reservationIdColumn"
                             prefWidth="95.0" text="Reservation ID" />
                <TableColumn fx:id="guestIdColumn"
                             prefWidth="70.0" text="Guest ID" />
                <TableColumn fx:id="roomColumn"
                             prefWidth="60.0" text="Room" />
                <TableColumn fx:id="checkInColumn"
                             prefWidth="95.0" text="Check-in" />
                <TableColumn fx:id="checkOutColumn"
                             prefWidth="95.0" text="Check-out" />
                <TableColumn fx:id="statusColumn"
                             prefWidth="90.0" text="Status" />
                <TableColumn fx:id="totalColumn"
                             prefWidth="115.0" text="Total (SAR)" />
            </columns>
        </TableView>

        <!-- Left Sidebar -->
        <AnchorPane prefHeight="650.0" prefWidth="280.0"
                    style="-fx-background-color: #1F3B57;">
            <children>

                <Label layoutX="25.0" layoutY="45.0"
                       text="Hotel" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>

                <Label layoutX="25.0" layoutY="100.0"
                       text="Booking" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>

                <Region layoutX="25.0" layoutY="175.0"
                        prefHeight="4.0" prefWidth="75.0"
                        style="-fx-background-color: #D4AF37;" />

                <Label layoutX="25.0" layoutY="205.0"
                       text="Manage Reservations"
                       textFill="#C7D3E0">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>

                <!-- Back Button -->
                <Button layoutX="20.0" layoutY="560.0"
                        mnemonicParsing="false"
                        prefHeight="40.0" prefWidth="240.0"
                        onAction="#handleBack"
                        style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="Back to Dashboard"
                        textFill="#1F3B57">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Button>

            </children>
        </AnchorPane>

        <!-- Main Title -->
        <Label layoutX="325.0" layoutY="25.0"
               text="Manage Reservations"
               textFill="#1F3B57">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <!-- Description -->
        <Label layoutX="325.0" layoutY="78.0"
               prefWidth="400.0"
               text="View, update and cancel hotel reservations"
               textFill="#5B6474">
            <font>
                <Font size="13.0" />
            </font>
        </Label>

        <!-- Search Field -->
        <TextField fx:id="searchField"
                   layoutX="325.0" layoutY="145.0"
                   prefHeight="35.0" prefWidth="300.0"
                   promptText="Search by reservation ID..."
                   style="-fx-text-fill: #374151; -fx-prompt-text-fill: #5B6474; -fx-background-color: #FFFFFF; -fx-border-color: #D1D5DB; -fx-border-radius: 4; -fx-background-radius: 4;">
            <font>
                <Font size="13.0" />
            </font>
        </TextField>

        <!-- Edit Section -->
        <Label layoutX="325.0" layoutY="430.0"
               text="Edit Reservation" textFill="#1F3B57">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <Label layoutX="325.0" layoutY="470.0"
               text="Check-in Date" textFill="#374151">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <Label layoutX="650.0" layoutY="470.0"
               text="Check-out Date" textFill="#374151">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Label>

        <!-- Date Pickers -->
        <DatePicker fx:id="checkInDatePicker"
                    layoutX="325.0" layoutY="495.0"
                    prefHeight="30.0" prefWidth="280.0" />

        <DatePicker fx:id="checkOutDatePicker"
                    layoutX="650.0" layoutY="495.0"
                    prefHeight="30.0" prefWidth="280.0" />

        <!-- Update Button -->
        <Button layoutX="325.0" layoutY="550.0"
                mnemonicParsing="false"
                prefHeight="40.0" prefWidth="110.0"
                onAction="#handleUpdate"
                style="-fx-background-color: #1F3B57; -fx-background-radius: 6; -fx-cursor: hand;"
                text="Update" textFill="WHITE">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Button>

        <!-- Cancel Button -->
        <Button layoutX="455.0" layoutY="550.0"
                mnemonicParsing="false"
                prefHeight="40.0" prefWidth="180.0"
                onAction="#handleCancelReservation"
                style="-fx-background-color: #1F3B57; -fx-background-radius: 6; -fx-cursor: hand;"
                text="Cancel Reservation" textFill="WHITE">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Button>

        <!-- Clear Button -->
        <Button layoutX="655.0" layoutY="550.0"
                mnemonicParsing="false"
                prefHeight="40.0" prefWidth="110.0"
                onAction="#handleClear"
                style="-fx-background-color: #FFFFFF; -fx-border-color: #1F3B57; -fx-background-radius: 6; -fx-border-radius: 6; -fx-cursor: hand;"
                text="Clear" textFill="#1F3B57">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Button>

    </children>
</AnchorPane>
